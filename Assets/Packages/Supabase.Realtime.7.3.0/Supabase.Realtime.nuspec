<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Supabase.Realtime</id>
    <version>7.3.0</version>
    <title>Supabase.Realtime</title>
    <authors>Joseph Schultz &lt;joseph@acupofjose.com&gt;</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/supabase/realtime-csharp</projectUrl>
    <description>Realtime-csharp is written as a client library for supabase/realtime.</description>
    <copyright>MIT</copyright>
    <tags>supabase, realtime, phoenix</tags>
    <repository type="git" url="https://github.com/supabase/realtime-csharp" commit="1e30dced86d7c55a0d37c45dd54e3c2c1018198d" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Newtonsoft.Json" version="13.0.2" exclude="Build,Analyzers" />
        <dependency id="Supabase.Core" version="1.1.0" exclude="Build,Analyzers" />
        <dependency id="Supabase.Postgrest" version="4.3.0" exclude="Build,Analyzers" />
        <dependency id="Websocket.Client" version="5.5.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Newtonsoft.Json" version="13.0.2" exclude="Build,Analyzers" />
        <dependency id="Supabase.Core" version="1.1.0" exclude="Build,Analyzers" />
        <dependency id="Supabase.Postgrest" version="4.3.0" exclude="Build,Analyzers" />
        <dependency id="Websocket.Client" version="5.5.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>