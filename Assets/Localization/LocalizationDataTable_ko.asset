      m_Items: []
  - m_Id: 75763234259673090
    m_Localized: "1\uD68C \uCD5C\uB300 \uC0AC\uC6A9 \uAC00\uB2A5 \uC218\uB7C9 : 1"
    m_Metadata:
      m_Items: []
  - m_Id: 75763988210982912
    m_Localized: "\uBCF4\uC720\uB7C9"
    m_Metadata:
      m_Items: []
  - m_Id: 75769393515405312
    m_Localized: "\uC11C\uC2DD\uC9C0 \uD0C0\uC77C \uD558\uB098\uB97C \uC5B4\uB5A0\uD55C
      \uC11C\uC2DD\uC9C0\uC640\uB3C4 \uB9E4\uCE58\uD560 \uC218 \uC788\uB294 \uC870\uCEE4
      \uD0C0\uC77C\uB85C \uBCC0\uACBD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 75769393515405313
    m_Localized: "\uBC29\uD574\uD0C0\uC77C \uD558\uB098\uB97C \uC120\uD0DD\uD558\uC5EC
      \uC989\uC2DC \uC18C\uBAA8\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 75769393515405314
    m_Localized: "\uC120\uD0DD\uD55C \uC704\uCE58\uC5D0 \uBC14\uB78C \uC9C0\uC6D0
      \uD0C0\uC77C\uC744 \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 75769393515405315
    m_Localized: "\uB192\uC740 \uB2E8\uACC4\uC758 \uC544\uAD70\uC774 \uB4F1\uC7A5\uD560
      \uD655\uB960\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80006151862034432
    m_Localized: "\uB2E4\uC774\uC544"
    m_Metadata:
      m_Items: []
  - m_Id: 80006151891394560
    m_Localized: "{0} \uCF64\uBCF4\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC \uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 80007012629684224
    m_Localized: "\uCF64\uBCF4 \uC815\uB82C \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 80008172656730112
    m_Localized: "\uAC00\uC7A5 \uB192\uC740 \uB4F1\uAE09\uC758 \uC544\uAD70 \uC720\uB2DB\uC744
      {0}{1}\uB9C8\uB9AC \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80008172656730113
    m_Localized: "\uC544\uAD70 \uC720\uB2DB\uC758 \uACF5\uACA9\uB825, \uACF5\uACA9
      \uC18D\uB3C4, \uC774\uB3D9 \uC18D\uB3C4\uAC00 {0}{1}\uBC30 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80008172656730114
    m_Localized: "\uD2B9\uC218 \uD37C\uC990\uC744 {0}{1}\uAC1C \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80008172656730115
    m_Localized: "\uBAA8\uB4E0 \uC544\uAD70 \uC720\uB2DB\uC758 \uCCB4\uB825\uC744
      \uCD5C\uB300 \uCCB4\uB825\uC758 {0}{1}\uB9CC\uD07C \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80008172656730116
    m_Localized: "\uC801 \uC720\uB2DB\uC758 \uACF5\uACA9 \uC18D\uB3C4\uC640 \uC774\uB3D9
      \uC18D\uB3C4\uAC00 {0}{1}\uBC30\uB85C \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
