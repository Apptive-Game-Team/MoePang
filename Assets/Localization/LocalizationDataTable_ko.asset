  - m_Id: 80018093347512320
    m_Localized: "\uADFC\uC811\uACF5\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512321
    m_Localized: "\uBC94\uC704\uACF5\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512322
    m_Localized: "\uB2E4\uC218\uD0C0\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512323
    m_Localized: "\uC6D0\uAC70\uB9AC\uACF5\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512324
    m_Localized: "\uC791\uC740 \uBAB8\uC73C\uB85C \uD480\uC232 \uC0AC\uC774\uB97C
      \uBE60\uB974\uAC8C \uC624\uAC00\uB294 \uC815\uCC30\uBCD1\uC785\uB2C8\uB2E4.
      \uAC81\uC774 \uB9CE\uC544 \uBCF4\uC5EC\uB3C4 \uCE5C\uAD6C\uB4E4\uC744 \uC704\uD574
      \uB204\uAD6C\uBCF4\uB2E4 \uBA3C\uC800 \uC6C0\uC9C1\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512325
    m_Localized: "\uAE34 \uB2E4\uB9AC\uC640 \uC608\uBBFC\uD55C \uAC10\uAC01\uC73C\uB85C
      \uBA40\uB9AC \uC788\uB294 \uC704\uD5D8\uC744 \uBA3C\uC800 \uC54C\uC544\uCC28\uB9BD\uB2C8\uB2E4.
      \uC870\uC6A9\uD558\uC9C0\uB9CC \uCD08\uC6D0\uC744 \uC9C0\uD0A4\uB294 \uC77C\uC5D0\uB294
      \uB9DD\uC124\uC784\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512326
    m_Localized: "\uBB34\uB9AC\uC640 \uD568\uAED8 \uC6C0\uC9C1\uC774\uBA70 \uC801\uC758
      \uBE48\uD2C8\uC744 \uB178\uB9AC\uB294 \uC601\uB9AC\uD55C \uC0AC\uB0E5\uAFBC\uC785\uB2C8\uB2E4.
      \uC870\uAE08 \uBB34\uC11C\uC6CC \uBCF4\uC5EC\uB3C4 \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C\uB294
      \uB4E0\uB4E0\uD55C \uD30C\uC218\uAFBC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512327
    m_Localized: "\uAE34 \uBAA9\uC73C\uB85C \uBA40\uB9AC\uAE4C\uC9C0 \uC0B4\uD53C\uB294
      \uCD08\uC6D0\uC758 \uAC10\uC2DC\uC790\uC785\uB2C8\uB2E4. \uB290\uAE0B\uD574
      \uBCF4\uC5EC\uB3C4 \uC704\uD5D8\uC774 \uC624\uBA74 \uAC00\uC7A5 \uBA3C\uC800
      \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C \uC54C\uB824\uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512328
    m_Localized: "\uAC15\uD55C \uD798\uACFC \uB0A0\uCE74\uB85C\uC6B4 \uC6C0\uC9C1\uC784\uC744
      \uAC00\uC9C4 \uCD08\uC6D0\uC758 \uC218\uD638\uC790\uC785\uB2C8\uB2E4. \uC870\uC6A9\uD788
      \uAE30\uB2E4\uB9AC\uB2E4 \uACB0\uC815\uC801\uC778 \uC21C\uAC04\uC5D0 \uD798\uC744
      \uBC1C\uD718\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512329
    m_Localized: "\uBB3C\uACB0\uC744 \uB530\uB77C \uB465\uC2E4\uB465\uC2E4 \uB5A0\uB2E4\uB2C8\uB294
      \uC2E0\uBE44\uB85C\uC6B4 \uCE5C\uAD6C\uC785\uB2C8\uB2E4. \uBD80\uB4DC\uB7EC\uC6CC
      \uBCF4\uC774\uC9C0\uB9CC \uAC00\uAE4C\uC774 \uC628 \uC801\uC5D0\uAC8C\uB294
      \uB530\uB054\uD55C \uD55C \uBC29\uC744 \uBCF4\uC5EC\uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512330
    m_Localized: "\uB2E8\uB2E8\uD55C \uB4F1\uAECD\uC9C8\uB85C \uBAB8\uC744 \uC9C0\uD0A4\uBA70
      \uCC9C\uCC9C\uD788 \uB098\uC544\uAC00\uB294 \uB3D9\uBB3C\uC785\uB2C8\uB2E4.
      \uB290\uB824 \uBCF4\uC5EC\uB3C4 \uC808\uB300 \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294
      \uBC14\uB2E4\uC758 \uB4E0\uB4E0\uD55C \uCE5C\uAD6C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512331
    m_Localized: "\uBB3C\uC18D\uC5D0\uC11C\uB294 \uBE60\uB974\uACE0 \uB545 \uC704\uC5D0\uC11C\uB294
      \uADC0\uC5FD\uAC8C \uB4A4\uB6B1\uAC70\uB9BD\uB2C8\uB2E4. \uC7A5\uB09C\uAE30
      \uB9CE\uC740 \uBAA8\uC2B5\uC73C\uB85C \uBC14\uB2E4 \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C
      \uD798\uC744 \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512332
    m_Localized: "\uCEE4\uB2E4\uB780 \uBAB8\uACFC \uAC15\uD55C \uD798\uC73C\uB85C
      \uC55E\uC744 \uB9C9\uC544\uC11C\uB294 \uB4E0\uB4E0\uD55C \uCE5C\uAD6C\uC785\uB2C8\uB2E4.
      \uD3C9\uC18C\uC5D0\uB294 \uB290\uAE0B\uD558\uC9C0\uB9CC, \uD654\uAC00 \uB098\uBA74
      \uB204\uAD6C\uB3C4 \uC27D\uAC8C \uB9C9\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512333
    m_Localized: "\uB113\uC740 \uBC14\uB2E4\uB97C \uD488\uC740 \uAC70\uB300\uD55C
      \uC218\uD638\uC790\uC785\uB2C8\uB2E4. \uBB35\uC9C1\uD55C \uC6C0\uC9C1\uC784\uB9CC\uC73C\uB85C\uB3C4
      \uC801\uC5D0\uAC8C \uD070 \uC555\uBC15\uC744 \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512334
    m_Localized: "\uBAA8\uB798 \uC18D\uC5D0 \uC228\uC5B4 \uC788\uB2E4\uAC00 \uACB0\uC815\uC801\uC778
      \uC21C\uAC04\uC5D0 \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0C5\uB2C8\uB2E4. \uC791\uC9C0\uB9CC
      \uB0A0\uCE74\uB85C\uC6B4 \uAF2C\uB9AC\uB85C \uC801\uC744 \uAE34\uC7A5\uD558\uAC8C
      \uB9CC\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512335
    m_Localized: "\uB2E8\uB2E8\uD55C \uAECD\uC9C8\uB85C \uBAB8\uC744 \uBCF4\uD638\uD558\uB294
      \uBC29\uC5B4\uC801\uC778 \uB3D9\uBB3C\uC785\uB2C8\uB2E4. \uC704\uD5D8\uD560
      \uB54C\uB294 \uBAB8\uC744 \uC6C5\uD06C\uB9AC\uACE0 \uCE68\uCC29\uD558\uAC8C
      \uBC84\uD168\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512336
    m_Localized: "\uB728\uAC70\uC6B4 \uBAA8\uB798\uBC14\uB78C \uC18D\uC5D0\uC11C\uB3C4
      \uAFCB\uAFCB\uD558\uAC8C \uAC78\uC5B4\uAC00\uB294 \uCE5C\uAD6C\uC785\uB2C8\uB2E4.
      \uAE34 \uC5EC\uC815\uC744 \uBC84\uD2F0\uB294 \uB048\uAE30\uB85C \uC0AC\uB9C9\uC758
      \uAE38\uC744 \uC9C0\uCF1C\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512337
    m_Localized: "\uB0A0\uCE74\uB85C\uC6B4 \uAC10\uAC01\uACFC \uBE60\uB978 \uD310\uB2E8\uB825\uC73C\uB85C
      \uAE30\uD68C\uB97C \uB193\uCE58\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uC6C3\uB294
      \uC5BC\uAD74\uCC98\uB7FC \uBCF4\uC5EC\uB3C4 \uC804\uC7A5\uC5D0\uC11C\uB294
      \uAF64 \uC601\uB9AC\uD55C \uC0AC\uB0E5\uAFBC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512338
    m_Localized: "\uAC15\uD55C \uD798\uACFC \uC704\uC5C4\uC73C\uB85C \uC0AC\uB9C9\uC744
      \uC9C0\uD0A4\uB294 \uC218\uD638\uC790\uC785\uB2C8\uB2E4. \uD55C \uBC88 \uD3EC\uD6A8\uD558\uBA74
      \uC8FC\uBCC0\uC758 \uC801\uB4E4\uC774 \uBAA8\uB450 \uAE34\uC7A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512339
    m_Localized: "\uC791\uC740 \uBAB8\uC73C\uB85C \uD3F4\uC9DD\uD3F4\uC9DD \uB6F0\uC5B4\uB2E4\uB2C8\uB294
      \uC232\uC18D \uCE5C\uAD6C\uC785\uB2C8\uB2E4. \uBE60\uB978 \uC6C0\uC9C1\uC784\uC73C\uB85C
      \uC801\uC744 \uD5F7\uAC08\uB9AC\uAC8C \uB9CC\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512340
    m_Localized: "\uB290\uAE0B\uD558\uACE0 \uC628\uC21C\uD55C \uC131\uACA9\uC73C\uB85C
      \uBAA8\uB450\uB97C \uD3B8\uC548\uD558\uAC8C \uD574\uC8FC\uB294 \uB3D9\uBB3C\uC785\uB2C8\uB2E4.
      \uD558\uC9C0\uB9CC \uCE5C\uAD6C\uB4E4\uC774 \uC704\uD5D8\uD558\uBA74 \uBB35\uBB35\uD788
      \uC55E\uC744 \uC9C0\uCF1C\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512341
    m_Localized: "\uAE34 \uC8FC\uB465\uC774\uC640 \uB0A0\uCE74\uB85C\uC6B4 \uBC1C\uD1B1\uC744
      \uAC00\uC9C4 \uB3C5\uD2B9\uD55C \uB3D9\uBB3C\uC785\uB2C8\uB2E4. \uC870\uC6A9\uD788
      \uB2E4\uAC00\uAC00 \uC801\uC758 \uBE48\uD2C8\uC744 \uCF55 \uC9D1\uC5B4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512342
    m_Localized: "\uC232\uC18D\uC744 \uC870\uC6A9\uD788 \uAC00\uB85C\uC9C0\uB974\uB294
      \uB0A0\uB835\uD55C \uC0AC\uB0E5\uAFBC\uC785\uB2C8\uB2E4. \uBE60\uB978 \uC6C0\uC9C1\uC784\uC73C\uB85C
      \uC801\uC774 \uBC29\uC2EC\uD55C \uC21C\uAC04\uC744 \uB178\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512343
    m_Localized: "\uCEE4\uB2E4\uB780 \uBAB8\uACFC \uAC15\uD55C \uD798\uC73C\uB85C
      \uC232\uC744 \uC9C0\uD0A4\uB294 \uB4E0\uB4E0\uD55C \uC218\uD638\uC790\uC785\uB2C8\uB2E4.
      \uB290\uAE0B\uD558\uC9C0\uB9CC \uD55C \uAC78\uC74C\uB9C8\uB2E4 \uBB35\uC9C1\uD55C
      \uC874\uC7AC\uAC10\uC744 \uBCF4\uC5EC\uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512344
    m_Localized: "\uC0C8\uD558\uC580 \uB208\uBC2D \uC0AC\uC774\uB97C \uBE60\uB974\uAC8C
      \uB6F0\uC5B4\uB2E4\uB2C8\uB294 \uC791\uC740 \uCE5C\uAD6C\uC785\uB2C8\uB2E4.
      \uC870\uC6A9\uD574 \uBCF4\uC5EC\uB3C4 \uB204\uAD6C\uBCF4\uB2E4 \uBBFC\uCCA9\uD558\uAC8C
      \uC6C0\uC9C1\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512345
    m_Localized: "\uB4A4\uB6B1\uB4A4\uB6B1 \uAC77\uC9C0\uB9CC \uC5BC\uC74C \uC704\uC5D0\uC11C\uB294
      \uC529\uC529\uD558\uAC8C \uB098\uC544\uAC11\uB2C8\uB2E4. \uB118\uC5B4\uC838\uB3C4
      \uAE08\uBC29 \uC77C\uC5B4\uB098\uB294 \uADC0\uC5EC\uC6B4 \uC6A9\uC0AC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512346
    m_Localized: "\uD558\uC580 \uD138\uB85C \uB208\uBC2D\uC5D0 \uC228\uC5B4\uB4DC\uB294
      \uC601\uB9AC\uD55C \uB3D9\uBB3C\uC785\uB2C8\uB2E4. \uC870\uC6A9\uD788 \uC6C0\uC9C1\uC774\uB2E4\uAC00
      \uC801\uC774 \uBC29\uC2EC\uD55C \uC21C\uAC04\uC744 \uB178\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512347
    m_Localized: "\uB208\uBCF4\uB77C \uC18D\uC5D0\uC11C\uB3C4 \uAE38\uC744 \uC783\uC9C0
      \uC54A\uB294 \uB4E0\uB4E0\uD55C \uCE5C\uAD6C\uC785\uB2C8\uB2E4. \uCEE4\uB2E4\uB780
      \uBFD4\uB85C \uC55E\uAE38\uC744 \uC5F4\uBA70 \uB3D9\uB8CC\uB4E4\uC744 \uC774\uB04C\uC5B4
      \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 80018093347512348
    m_Localized: "\uB208\uACFC \uC5BC\uC74C\uC758 \uB545\uC744 \uC9C0\uD0A4\uB294
      \uAC15\uC778\uD55C \uC218\uD638\uC790\uC785\uB2C8\uB2E4. \uAC70\uB300\uD55C
      \uBAB8\uC73C\uB85C \uC801\uC758 \uAE38\uC744 \uB9C9\uC544\uC11C\uB294 \uB4E0\uB4E0\uD55C
      \uBC29\uD328\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
