  - m_Id: 75354666536607744
    m_Localized: "\uC720\uB2DB \uC18C\uD658\uC5D0 \uB354 \uB9CE\uC740 \uC2A4\uD0DD\uC774
      \uD544\uC694\uD569\uB2C8\uB2E4\r\n<size=30>\uC2A4\uD0DD \uBE44\uC6A9 : 3 ->
      6</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 75354666536607745
    m_Localized: "\uC801\uC758 \uB2A5\uB825\uCE58\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4\r\n<size=30>\uBAA8\uB4E0
      \uB2A5\uB825\uCE58 x 1.5</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 75354666536607746
    m_Localized: "\uBAA8\uB798\uD3ED\uD48D\uC774 \uC8FC\uAE30\uC801\uC73C\uB85C \uD37C\uC990\uD310\uC744
      \uAC00\uB9BD\uB2C8\uB2E4\r\n<size=30>15\uCD08\uB9C8\uB2E4 \uD0C0\uC77C\uC774
      3\uCD08 \uB3D9\uC548 \uAC00\uB824\uC9D1\uB2C8\uB2E4.</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 75354666536607747
    m_Localized: "\uC544\uAD70 \uC720\uB2DB\uC758 \uC774\uB3D9 \uC18D\uB3C4\uC640
      \uACF5\uACA9 \uC18D\uB3C4\uAC00 \uAC10\uC18C\uD569\uB2C8\uB2E4\r\n<size=30>\uC18D\uB3C4
      \uBC0F \uACF5\uACA9 \uAD00\uB828 \uB2A5\uB825\uCE58 x 0.75</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 75354666536607748
    m_Localized: "\uC801\uC774 \uC8FC\uAE30\uC801\uC73C\uB85C \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4\r\n<size=30>\uBAA8\uB4E0 \uC801\uC774 15\uCD08\uB9C8\uB2E4
      \uCCB4\uB825\uC744 \uD68C\uBCF5\uD569\uB2C8\uB2E4</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 75754692697989120
